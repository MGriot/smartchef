# Copy to `keystore.properties` (same folder) and fill in. That file is
# gitignored, along with *.jks — the keystore is the app's identity, and an
# app signed with a different key can never update an installed one, so
# treat both as irreplaceable secrets and keep a backup outside this repo.
#
# storeFile is resolved relative to frontend/android/app/build.gradle, so a
# keystore at the repository root is ../../release.jks

storeFile=../../release.jks
storePassword=
keyAlias=release-alias
keyPassword=

# Equivalent environment variables, which take precedence when set — use
# these in CI instead of a file:
#   SMARTCHEF_KEYSTORE, SMARTCHEF_KEYSTORE_PASSWORD,
#   SMARTCHEF_KEY_ALIAS, SMARTCHEF_KEY_PASSWORD
