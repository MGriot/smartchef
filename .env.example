# SmartChef — Environment Variables
DB_PASSWORD=smartchef_secret
NODE_ENV=development
PORT=3000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Required in production (the server refuses to start with defaults). Generate: openssl rand -hex 32
SESSION_SECRET=change_me_in_production
LLM_KEY_ENCRYPTION_SECRET=change_me_in_production
# Directory where uploaded images are stored (defaults to ./uploads if unset)
UPLOAD_DIR=./uploads
