node_modules/
dist/
# Widened after a live GitHub token was found sitting in " (2).env" — a
# browser's duplicate-download name, which ".env" and ".env.local" did not
# match. Any stray copy is now ignored; the checked-in template is not.
.env
.env.*
*.env
!.env.example
*.log
.DS_Store
backend/uploads/
sync-data/
# Local agent/editor state. `.github/` is deliberately NOT here: ignoring it
# silently skips any new workflow, issue template or CODEOWNERS from `git add`.
.claude/
.scratch/
.stitch/
# Backup exports written by Account > Backup & Restore. They are a user's
# whole library (recipes, and optionally every image inline), so they are
# data rather than source and can be tens of megabytes.
smartchef-backup-*.json
# Stray working images dropped at the repo root while designing avatars.
/Avatars.jpeg

# Android release signing. The keystore IS the app's identity: an app signed
# with a different key can never update an installed one, so this file is
# both irreplaceable and a secret. Never commit it, and keep a backup
# somewhere that is not this repo.
*.jks
*.keystore
keystore.properties

# Staging folder for the installers and APKs attached to a GitHub release by
# hand. Half a gigabyte of build output that already lives on the release
# page; it has no business in the history.
release-assets/

# Root scratch kept on disk but out of the history: a one-line curl payload,
# an April design mock that the Vite build never referenced, and a stale
# self-analysis note superseded by docs/.
/test_payload.json
/gallery.html
/REPO_ANALYSIS.md
