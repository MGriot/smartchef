# SmartChef — environment configuration
# Copy this file to `.env` in the same folder (docker/.env) and fill in
# real values. `.env` itself is gitignored — never commit real secrets.
#
#   cp .env.example .env

# ── Database ────────────────────────────────────────────────────────────
# Password for the Postgres container. Change this for anything beyond
# local experimentation.
DB_PASSWORD=smartchef_secret

# ── Auth (login sessions) ───────────────────────────────────────────────
# Signs the session JWT. Must be a long random string, and must stay the
# same across restarts or every logged-in device gets signed out. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Session cookie behavior. Leave these at their defaults for the normal
# same-origin browser setup (nginx serving the frontend and proxying
# /api on the same origin) — nothing below is needed for that case.
# Only change them once something calls the API from a *different* origin
# than the frontend is served from — e.g. the Capacitor Android app, which
# runs from capacitor://localhost and needs an absolute server URL (see
# frontend's "Connect to your server" screen) instead of relying on nginx
# proxying. In that case, once you have a real HTTPS address for the
# backend (e.g. via Tailscale — see docker/README or the setup chat for
# `tailscale serve` steps):
#   COOKIE_SAME_SITE=none   (required for a cross-origin cookie to be sent)
#   COOKIE_SECURE=true      (required by browsers whenever SameSite=none)
#   CORS_ORIGIN=https://your-tailscale-hostname.ts.net   (an explicit
#     origin, not "*" — browsers reject wildcard + credentialed requests)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
CORS_ORIGIN=*

# ── Folder-based multi-device sync (backup/sync across your own devices)
# Off by default — zero effect on a single-device setup. Turn on once you
# want two+ of your own SmartChef instances to back up and merge their
# libraries through a shared folder (see the Account page's "Multi-Device
# Sync" card once enabled).
SYNC_ENABLED=false

# A friendly label for this instance in the peer list (e.g. "Kitchen PC",
# "Matteo's Laptop"). Purely cosmetic.
DEVICE_NAME=SmartChef Device

# Host path SmartChef reads/writes its sync snapshot file in — point this
# at a real folder kept in sync by OneDrive/Google Drive/Dropbox's own
# desktop client (or a plain local folder) so another device can see it.
# Defaults to a folder inside the project if left unset.
# SYNC_FOLDER_HOST_PATH=C:/Users/you/OneDrive/SmartChefSync
